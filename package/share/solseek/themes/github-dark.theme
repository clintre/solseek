SS_THCLR_1="#ff7b72"  # Color 1: Red
SS_THCLR_2="#3fb950"  # Color 2: Green
SS_THCLR_3="#d29922"  # Color 3: Yellow
SS_THCLR_4="#58a6ff"  # Color 4: Blue
SS_THCLR_5="#bc8cff"  # Color 5: Magenta
SS_THCLR_6="#39c5cf"  # Color 6: Cyan
SS_THCLR_7="#b1bac4"  # Color 7: White
SS_THCLR_8="#6e7681"  # Color 8: Bright Black
